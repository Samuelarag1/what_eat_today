{
  "expo": {
    "name": "Que Comemos Hoy",
    "slug": "que-comemos-hoy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./public/icon-512.png",
    "scheme": "quecomemoshoy",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./public/icon-512.png",
        "backgroundColor": "#F7E5C6"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./public/icon-512.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0F3D3E",
          "image": "./public/icon-512.png",
          "imageWidth": 180
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
